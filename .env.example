# ============================================================
# 环境变量示例：复制为 .env 用于本地运行，或在 Vercel 项目
# 「Settings → Environment Variables」中配置。
# 切勿把真实 .env 提交到 Git。
# ============================================================

# OpenAI 兼容接口（默认 DeepSeek，可替换为 Moonshot/Qwen/智谱等）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：模型调用超时（毫秒）。须小于 Vercel Function 的 maxDuration（当前 30s）
LLM_TIMEOUT_MS=25000

# 可选：调用保护（按 IP 限流，尽力而为）。默认窗口 600000ms / 10 次
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10
