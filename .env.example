# ============================================================
# 环境变量示例：复制为 .env 用于本地运行；部署到 Netlify /
# Vercel 时，在平台「Environment Variables」中配置同名变量。
# 切勿把真实 .env 提交到 Git。
# ============================================================

# OpenAI 兼容接口（默认 DeepSeek，可替换为 Moonshot/Qwen/智谱等）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：模型调用超时（毫秒）。须小于函数运行时上限：
#   Vercel 上限 30s -> 用 25000；Netlify 免费版约 10s -> 建议 8000
LLM_TIMEOUT_MS=25000

# 可选：调用保护（按 IP 限流，尽力而为）。默认窗口 600000ms / 10 次
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10
